# Copie para .env apenas se quiser sobrescrever as variáveis do docker-compose.yml
# (o .env tem precedência). Nunca versione o .env real.
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=db
DB_PORT=3306
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk
DB_PASSWORD=secret

# Gere uma chave nova: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres-hexadecimais-xxxxx
JWT_TTL=3600

SLA_WORK_START=9
SLA_WORK_END=18
SLA_TIMEZONE=America/Sao_Paulo

# SMTP (também pode ser configurado pela tela Envio de e-mail)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_AUTH=login
MAIL_FROM_ADDRESS=helpdesk@suaempresa.com.br
MAIL_FROM_NAME="BRASO Helpdesk"
